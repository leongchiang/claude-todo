# Copy to .env.local and fill in. Never commit a populated .env file.

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID — https://entra.microsoft.com (App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Local SQLite database file (gitignored)
DATABASE_PATH=./data/todo.db
